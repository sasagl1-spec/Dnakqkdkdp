from .. import loader, utils
import asyncio
import logging
from telethon.tl.types import Message

logger = logging.getLogger(__name__)

@loader.tds
class ForwardDelayMod(loader.Module):
    """Модуль пересылки сообщений с задержкой"""
    
    strings = {
        "name": "ForwardDelay",
        "no_reply": "🚫 <b>Ответь на сообщение для пересылки</b>",
        "invalid_args": "🚫 <b>Неверные аргументы</b>\n<code>.setforward &lt;задержка&gt; &lt;количество&gt;</code>",
        "task_started": "✅ <b>Задача запущена!</b>\n📤 Пересылаю <b>{count}</b> раз\n⏱ Задержка: <b>{delay} сек</b>",
        "task_running": "⚠️ <b>Уже есть активная задача</b>\nИспользуй <code>.stopforward</code> для отмены",
        "task_stopped": "⏹️ <b>Пересылка остановлена</b>",
        "no_task": "📭 <b>Нет активных задач</b>",
        "progress": "🔄 <b>Прогресс:</b> {current}/{total}",
        "complete": "✅ <b>Пересылка завершена!</b>",
    }
    
    strings_ru = {
        "no_reply": "🚫 <b>Ответь на сообщение для пересылки</b>",
        "invalid_args": "🚫 <b>Неверные аргументы</b>\n<code>.setforward &lt;задержка&gt; &lt;количество&gt;</code>",
        "task_started": "✅ <b>Задача запущена!</b>\n📤 Пересылаю <b>{count}</b> раз\n⏱ Задержка: <b>{delay} сек</b>",
        "task_running": "⚠️ <b>Уже есть активная задача</b>\nИспользуй <code>.stopforward</code> для отмены",
        "task_stopped": "⏹️ <b>Пересылка остановлена</b>",
        "no_task": "📭 <b>Нет активных задач</b>",
        "progress": "🔄 <b>Прогресс:</b> {current}/{total}",
        "complete": "✅ <b>Пересылка завершена!</b>",
    }
    
    def __init__(self):
        self.config = loader.ModuleConfig(
            loader.ConfigValue(
                "default_delay",
                1.0,
                "Задержка по умолчанию (сек)",
                validator=loader.validators.Float(minimum=0.1, maximum=300)
            ),
            loader.ConfigValue(
                "max_count",
                50,
                "Максимальное количество повторений",
                validator=loader.validators.Integer(minimum=1, maximum=1000)
            )
        )
        self.task = None
        self.is_running = False
        self.current_progress = None
    
    async def client_ready(self, client, db):
        self.client = client
        self.db = db
        self._client = client
        logger.info("ForwardDelay загружен")
    
    @loader.command(
        ru_doc="<задержка> <количество> - Переслать сообщение с задержкой",
        en_doc="<delay> <count> - Forward message with delay"
    )
    async def setforwardcmd(self, message: Message):
        """Переслать сообщение с задержкой"""
        # Проверка реплая
        reply = await message.get_reply_message()
        if not reply:
            await utils.answer(message, self.strings("no_reply"))
            return
        
        # Проверка активной задачи
        if self.is_running:
            await utils.answer(message, self.strings("task_running"))
            return
        
        # Парсинг аргументов
        args = utils.get_args(message)
        
        # Используем аргументы или значения по умолчанию
        if len(args) >= 2:
            try:
                delay = float(args[0])
                count = int(args[1])
            except ValueError:
                await utils.answer(message, self.strings("invalid_args"))
                return
        else:
            delay = self.config["default_delay"]
            count = 1
        
        # Валидация
        if delay < 0.1:
            delay = 0.1
        if delay > 300:
            delay = 300
        
        if count > self.config["max_count"]:
            count = self.config["max_count"]
        
        # Получаем чат
        chat = await message.get_chat()
        chat_id = chat.id
        
        # Запуск задачи
        self.is_running = True
        self.task = asyncio.create_task(
            self._forward_task(message, reply, chat_id, delay, count)
        )
        
        await utils.answer(
            message,
            self.strings("task_started").format(
                delay=delay,
                count=count
            )
        )
    
    @loader.command(
        ru_doc="Остановить текущую пересылку",
        en_doc="Stop current forwarding"
    )
    async def stopforwardcmd(self, message: Message):
        """Остановить пересылку"""
        if not self.is_running:
            await utils.answer(message, self.strings("no_task"))
            return
        
        if self.task:
            self.task.cancel()
            self.task = None
        
        self.is_running = False
        await utils.answer(message, self.strings("task_stopped"))
    
    @loader.command(
        ru_doc="Статус пересылки",
        en_doc="Forwarding status"
    )
    async def forwardstatuscmd(self, message: Message):
        """Статус пересылки"""
        if not self.is_running:
            await utils.answer(message, self.strings("no_task"))
            return
        
        if self.current_progress:
            await utils.answer(
                message,
                self.strings("progress").format(
                    current=self.current_progress[0],
                    total=self.current_progress[1]
                )
            )
        else:
            await utils.answer(message, "🔄 <b>Задача выполняется</b>")
    
    async def _forward_task(self, message: Message, reply_msg: Message, chat_id: int, delay: float, count: int):
        """Асинхронная задача пересылки"""
        try:
            for i in range(count):
                if not self.is_running:
                    break
                
                # Обновляем прогресс
                self.current_progress = (i + 1, count)
                
                # Пересылаем сообщение
                await reply_msg.forward_to(chat_id)
                
                logger.info(f"Пересылка {i+1}/{count} в чат {chat_id}")
                
                # Задержка (кроме последней итерации)
                if i < count - 1:
                    await asyncio.sleep(delay)
            
            # Завершение
            if self.is_running:
                await self.client.send_message(
                    chat_id,
                    self.strings("complete"),
                    reply_to=message.id if hasattr(message, 'id') else None
                )
            
        except asyncio.CancelledError:
            logger.info("Задача пересылки отменена")
        except Exception as e:
            logger.error(f"Ошибка в задаче пересылки: {e}")
            await self.client.send_message(
                chat_id,
                f"❌ <b>Ошибка:</b> {str(e)}",
                reply_to=message.id if hasattr(message, 'id') else None
            )
        finally:
            self.is_running = False
            self.task = None
            self.current_progress = None
    
    async def on_unload(self):
        """При выгрузке модуля"""
        if self.task:
            self.task.cancel()
        self.is_running = False
