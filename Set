    def __init__(self):
        self.config = loader.ModuleConfig(
            loader.ConfigValue(
                "auto_save",
                True,
                lambda: self.strings("config_enabled"),
                validator=loader.validators.Boolean()
            )
        )
        self.tasks = {}
        self.task_counter = 0
        self.active_tasks = {}
    
    async def client_ready(self, client, db):
        self.client = client
        self.db = db
        self._db = db
        logger.info("AutoForwardMod загружен")
    
    @loader.command(ru_doc="Установить задачу пересылки - .setforward <команда> <интервал> <количество>")
    async def setforwardcmd(self, message):
        """<команда> <интервал_сек> <количество> - установить задачу пересылки"""
        args = utils.get_args(message)
        
        if len(args) < 3:
            await utils.answer(message, self.strings("invalid_args"))
            return
        
        command = args[0]
        try:
            interval = int(args[1])
            count = int(args[2])
        except ValueError:
            await utils.answer(message, self.strings("invalid_args"))
            return
        
        if interval < 1 or count < 1:
            await utils.answer(message, "❌ Интервал и количество должны быть больше 0")
            return
        
        chat = await message.get_chat()
        chat_id = chat.id
        chat_title = chat.title if hasattr(chat, 'title') else f"ID: {chat_id}"
        
        task_id = self.task_counter
        self.task_counter += 1
        
        task_data = {
            "id": task_id,
            "chat_id": chat_id,
            "chat_title": chat_title,
            "command": command,
            "interval": interval,
            "count": count,
            "original_message": message.id,
            "created": time.time(),
            "running": False,
            "completed": 0
        }
        
        self.tasks[task_id] = task_data
        self._save_tasks()
        
        await utils.answer(
            message,
            self.strings("task_created").format(
                chat_title, command, interval, count
            )
        )
    
    @loader.command(ru_doc="Запустить задачу пересылки")
    async def startforwardcmd(self, message):
        """<id_задачи> - запустить задачу"""
        args = utils.get_args(message)
        
        if not args:
            await utils.answer(message, "❌ Укажите ID задачи")
            return
        
        try:
            task_id = int(args[0])
        except ValueError:
            await utils.answer(message, "❌ Неверный ID задачи")
            return
        
        if task_id not in self.tasks:
            await utils.answer(message, self.strings("task_not_found").format(task_id))
            return
        
        task = self.tasks[task_id]
        
        if task["running"]:
            await utils.answer(message, self.strings("task_already_running").format(task_id))
            return
        
        task["running"] = True
        self._save_tasks()
        
        # Запускаем асинхронную задачу
        asyncio.create_task(self._forward_task(task_id))
        
        await utils.answer(message, self.strings("task_started").format(task_id))
    
    @loader.command(ru_doc="Остановить задачу")
    async def stopforwardcmd(self, message):
        """<id_задачи> - остановить задачу"""
        args = utils.get_args(message)
        
        if not args:
            await utils.answer(message, "❌ Укажите ID задачи")
            return
        
        try:
            task_id = int(args[0])
        except ValueError:
            await utils.answer(message, "❌ Неверный ID задачи")
            return
        
        if task_id not in self.tasks:
            await utils.answer(message, self.strings("task_not_found").format(task_id))
            return
        
        task = self.tasks[task_id]
        task["running"] = False
        
        if task_id in self.active_tasks:
            self.active_tasks[task_id].cancel()
            del self.active_tasks[task_id]
        
        self._save_tasks()
        await utils.answer(message, self.strings("task_stopped").format(task_id))
    
    @loader.command(ru_doc="Показать все задачи")
    async def forwardtaskscmd(self, message):
        """- показать все задачи пересылки"""
        if not self.tasks:
            await utils.answer(message, self.strings("no_tasks"))
            return
        
        text = "📋 **Активные задачи пересылки:**\n\n"
        
        for task_id, task in self.tasks.items():
            status = "🟢 Запущена" if task["running"] else "🔴 Остановлена"
            created = datetime.fromtimestamp(task["created"]).strftime("%d.%m.%Y %H:%M")
            
            text += (
                f"**ID:** {task_id}\n"
                f"**Чат:** {task['chat_title']}\n"
                f"**Команда:** `{task['command']}`\n"
                f"**Интервал:** {task['interval']} сек\n"
                f"**Количество:** {task['count']}\n"
                f"**Выполнено:** {task['completed']}/{task['count']}\n"
                f"**Статус:** {status}\n"
                f"**Создана:** {created}\n"
                f"{'-'*30}\n"
            )
        
        text += f"\n**Всего задач:** {len(self.tasks)}"
        await utils.answer(message, text)
    
    @loader.command(ru_doc="Удалить задачу")
    async def delforwardcmd(self, message):
        """<id_задачи> - удалить задачу"""
        args = utils.get_args(message)
        
        if not args:
            await utils.answer(message, "❌ Укажите ID задачи")
            return
        
        try:
            task_id = int(args[0])
        except ValueError:
            await utils.answer(message, "❌ Неверный ID задачи")
            return
        
        if task_id not in self.tasks:
            await utils.answer(message, self.strings("task_not_found").format(task_id))
            return
        
        # Останавливаем задачу если она запущена
        if task_id in self.active_tasks:
            self.active_tasks[task_id].cancel()
            del self.active_tasks[task_id]
        
        del self.tasks[task_id]
        self._save_tasks()
        
        await utils.answer(message, self.strings("task_removed").format(task_id))
    
    @loader.command(ru_doc="Тестовая пересылка")
    async def testforwardcmd(self, message):
        """- тестовая пересылка текущего сообщения"""
        try:
            await message.forward_to(await message.get_chat())
            await utils.answer(message, self.strings("test_forward"))
        except Exception as e:
            await utils.answer(message, f"❌ Ошибка: {str(e)}")
    
    async def _forward_task(self, task_id):
        """Выполнение задачи пересылки"""
        task = self.tasks.get(task_id)
        if not task or not task["running"]:
            return
        
        chat_id = task["chat_id"]
        command = task["command"]
        interval = task["interval"]
        total_count = task["count"]
        
        for i in range(task["completed"], total_count):
            if not task["running"] or task_id not in self.tasks:
                break
            
            try:
                # Отправляем команду
                await self.client.send_message(
                    chat_id,
                    command,
                    parse_mode=None
                )
                
                # Обновляем счетчик
                task["completed"] = i + 1
                self._save_tasks()
                
                # Логируем
                logger.info(
                    f"Forward task {task_id}: {i+1}/{total_count} "
                    f"(chat: {chat_id}, command: {command})"
                )
                
                # Ждем указанный интервал
                if i < total_count - 1:  # Не ждем после последней отправки
                    await asyncio.sleep(interval)
                    
            except Exception as e:
                logger.error(f"Ошибка в задаче {task_id}: {e}")
                # Пауза при ошибке
                await asyncio.sleep(10)
        
        # Завершение задачи
        if task_id in self.tasks:
            self.tasks[task_id]["running"] = False
            self._save_tasks()
            
            if task_id in self.active_tasks:
                del self.active_tasks[task_id]
    
    def _save_tasks(self):
        """Сохранение задач в базу данных"""
        if self.config["auto_save"]:
            self._db.set(__name__, "tasks", self.tasks)
            self._db.set(__name__, "task_counter", self.task_counter)
    
    async def _load_tasks(self):
        """Загрузка задач из базы данных"""
        tasks = self._db.get(__name__, "tasks", {})
        counter = self._db.get(__name__, "task_counter", 0)
        
        # Конвертация ключей в int (при загрузке из JSON они становятся str)
        self.tasks = {int(k): v for k, v in tasks.items()}
        self.task_counter = counter
    
    async def on_unload(self):
        """Очистка при выгрузке модуля"""
        for task_id in list(self.active_tasks.keys()):
            self.active_tasks[task_id].cancel()
        self.active_tasks.clear()
